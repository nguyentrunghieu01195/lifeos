# ==============================================================================
# LifeOS environment configuration
# Copy to .env (development) or set these in Vercel project settings (production).
# Validation rules live in src/lib/env.ts — the app fails fast with a readable
# error when a required variable is missing in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
# Public origin of the deployed app (used for absolute URLs, SEO metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL connection string.
#   Production: Neon (https://neon.tech) — use the POOLED connection string.
#   Development: any local Postgres, or `pnpm db:local` to boot an embedded one.
# The data layer picks the right driver automatically (Neon serverless driver
# for *.neon.tech hosts, node-postgres otherwise). Override with DATABASE_DRIVER.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/lifeos

# Optional: force the database driver ("neon" or "pg") when host detection
# is not enough (e.g. Neon behind a custom domain).
# DATABASE_DRIVER=

# ------------------------------------------------------------------------------
# AI Gateway
# ------------------------------------------------------------------------------
# Active provider: gemini | groq | aiand. Switching providers requires no code
# changes — only the matching credentials below.
AI_PROVIDER=gemini

# Optional model override. Defaults: gemini -> gemini-2.5-flash,
# groq -> llama-3.3-70b-versatile. REQUIRED when AI_PROVIDER=aiand.
# AI_MODEL=

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq key (https://console.groq.com/keys)
GROQ_API_KEY=

# AIAND — any OpenAI-compatible endpoint. Both values are required when
# AI_PROVIDER=aiand. Example base URL: https://api.example.com/v1
AIAND_API_KEY=
AIAND_BASE_URL=

# ------------------------------------------------------------------------------
# Upstash Redis (cache + rate limiting) — https://console.upstash.com
# Optional in development (an in-memory rate limiter is used as fallback),
# required in production.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# Cloudflare R2 (documents, images, avatars) — S3-compatible API
# Create an API token with Object Read & Write on the bucket.
# Required in production; document/image features raise a clear
# "not configured" error in development until set.
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lifeos
# Optional: public base URL if the bucket is exposed via a custom domain.
# R2_PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# Environment validation
# ------------------------------------------------------------------------------
# Boot-time validation is strict automatically on Vercel production deploys.
# Set to "true" to enforce strict validation anywhere else (e.g. self-hosted).
# ENFORCE_ENV_VALIDATION=true
