// LifeOS Prisma schema.
//
// The client is generated into src/generated/prisma (gitignored) and accessed
// exclusively through src/lib/db.ts, which wires the Neon serverless driver in
// production and node-postgres in development (driver adapters).
//
// Schema evolution is strictly additive per phase; every phase lands its own
// migration.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Identity (Phase 2 — Auth.js v5 with JWT sessions)
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  /// Argon2id hash — null for OAuth-only accounts.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  tasks    Task[]
  projects Project[]
  tagsOwned Tag[]
  events   CalendarEvent[]
  notes    Note[]
  noteFolders NoteFolder[]
  documents Document[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// Present for Auth.js adapter compatibility and a future switch to database
// sessions; unused while the session strategy is JWT.
model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ----------------------------------------------------------------------------
// Tasks (Phase 4)
// ----------------------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RecurrenceFreq {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TaskSource {
  MANUAL
  AI
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, name])
  @@map("projects")
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String @default("#0ea5e9")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[] @relation("TaskTags")
  notes Note[] @relation("NoteTags")

  @@unique([userId, name])
  @@map("tags")
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  projectId   String?
  parentId    String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  source      TaskSource   @default(MANUAL)
  /// Fractional ordering inside a board column / list.
  position    Float        @default(0)
  dueAt       DateTime?
  reminderAt  DateTime?
  completedAt DateTime?

  /// Todoist-style recurrence: completing the task rolls dueAt forward by
  /// interval x freq instead of marking it done.
  recurrenceFreq     RecurrenceFreq?
  recurrenceInterval Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent   Task?    @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]   @relation("Subtasks")
  tags     Tag[]    @relation("TaskTags")

  @@index([userId, status])
  @@index([userId, dueAt])
  @@index([projectId])
  @@index([parentId])
  @@map("tasks")
}

// ----------------------------------------------------------------------------
// Calendar (Phase 5)
// ----------------------------------------------------------------------------

enum EventSource {
  LOCAL
  GOOGLE
}

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  color       String   @default("#6366f1")

  /// Sync-ready: LOCAL events are authored here; GOOGLE events carry the
  /// remote identifiers once calendar sync ships.
  source             EventSource @default(LOCAL)
  externalId         String?
  externalCalendarId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@index([userId, externalId])
  @@map("calendar_events")
}

// ----------------------------------------------------------------------------
// Notes (Phase 6)
// ----------------------------------------------------------------------------

model NoteFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]

  @@unique([userId, name])
  @@map("note_folders")
}

model Note {
  id       String  @id @default(cuid())
  userId   String
  folderId String?
  title    String  @default("Untitled")

  /// Tiptap document as JSON (jsonb).
  content Json

  /// Plain-text extraction of the content — previews now, full-text search later.
  contentText String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags   Tag[]       @relation("NoteTags")

  @@index([userId, updatedAt])
  @@index([folderId])
  @@map("notes")
}

// ----------------------------------------------------------------------------
// Documents (Phase 7)
// ----------------------------------------------------------------------------

enum DocumentStatus {
  /// Row created and an upload URL issued; bytes not yet verified in storage.
  PENDING
  /// Upload verified (size matched) — visible in the library.
  READY
}

model Document {
  id       String         @id @default(cuid())
  userId   String
  /// Display name (editable); the storage key keeps the original filename.
  name     String
  /// Object key in storage: {userId}/{documentId}/{sanitized-filename}.
  key      String         @unique
  mimeType String
  size     Int
  status   DocumentStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("documents")
}
